---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import ThemeAsset from '../../components/ThemeAsset.astro';
import * as stylex from '@stylexjs/stylex';
import { styles } from '../../styles/siteStyles';

const posts = (await getCollection('blog')).sort(
	(a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} />
	</head>
	<body {...stylex.props(styles.body)}>
		<Header />
		<main {...stylex.props(styles.main, styles.mainWide)}>
			<ThemeAsset src="/assets/theme/orbit-vignette.jpg" />
			<section>
				<ul {...stylex.props(styles.blogList)}>
					{
						posts.map((post, index) => (
							<li {...stylex.props(index === 0 ? styles.blogItemFeatured : styles.blogItem)}>
								<a href={`/blog/${post.id}/`} {...stylex.props(styles.blogItemLink, styles.blogItemLinkHover)}>
									<h4 {...stylex.props(styles.heading, styles.h4, styles.blogTitle, index === 0 && styles.blogTitleFeatured)}>{post.data.title}</h4>
									<p {...stylex.props(styles.date)}>
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
