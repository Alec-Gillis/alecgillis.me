---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import * as stylex from '@stylexjs/stylex';
import { styles } from '../styles/siteStyles';

type Props = CollectionEntry<'blog'>['data'] & {
	showHeroImage?: boolean;
	showMetadata?: boolean;
};

const { title, pubDate, updatedDate, heroImage, showHeroImage = false, showMetadata = true } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} />
	</head>

	<body {...stylex.props(styles.body)}>
		<Header />
		<main {...stylex.props(styles.main)}>
			<article>
				{showHeroImage && heroImage && (
					<div class="hero-image">
						<img width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<div {...stylex.props(styles.prose)}>
					{showMetadata && (
						<div {...stylex.props(styles.postTitle)}>
							<div {...stylex.props(styles.date)}>
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<div {...stylex.props(styles.updated)}>
											Last updated on <FormattedDate date={updatedDate} />
										</div>
									)
								}
							</div>
							<h1 {...stylex.props(styles.heading, styles.h1, styles.postTitleHeading)}>{title}</h1>
							<hr {...stylex.props(styles.postRule)} />
						</div>
					)}
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
